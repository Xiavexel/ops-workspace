# ==========================================================
# K8s 版本与镜像源 —— 唯一真实源（Single Source of Truth）
#
# 用法：
#   1) 被 03-k8s-install.sh / 04-kubeadm-init.sh / 09-restore-full.sh 自动 source
#   2) 也支持环境变量临时覆盖（env > 本文件 > 脚本内默认值）
#        K8S_PATCH=1.32.15 sudo ./03-k8s-install.sh
#   3) 升级集群只改这一个文件，三个脚本自动同步，避免"03 装 1.32、04 初始化 1.32.13"的版本错配
# ==========================================================

# 仓库线（用于 pkgs.k8s.io 的 URL 路径，必须是 vX.Y 形式）
K8S_MINOR="${K8S_MINOR:-v1.32}"

# 精确 patch 版本（用于 dnf install 锁版、kubeadm init --kubernetes-version）
K8S_PATCH="${K8S_PATCH:-1.32.13}"

# kubeadm 使用的完整版本号（带 v 前缀），由 K8S_PATCH 推导
K8S_VER="${K8S_VER:-v${K8S_PATCH}}"

# 国内镜像源
IMAGE_REPO="${IMAGE_REPO:-registry.aliyuncs.com/google_containers}"

# Flannel 默认 Pod 网段（一般不用改）
POD_CIDR="${POD_CIDR:-10.244.0.0/16}"
