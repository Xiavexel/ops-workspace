# ==========================================================
# mysql-compare：绑定挂载侧的对比配置
# 目的：和"仅用命名卷、纯默认参数"的容器做对比，观察参数变化带来的差异
# 用法：docker compose down && docker compose up -d 后，
#       进容器执行 `mysql -uroot -p -e "SHOW VARIABLES LIKE 'innodb_buffer_pool_size';"`
# 注意：容器内 my.cnf 必须 world-readable，且配置项要放在 [mysqld] 段内，
#       否则 mysqld 会直接拒绝启动（这是新手最常踩的坑）
# ==========================================================
[mysqld]
# 缓冲池：默认 128M，这里显式放大到 256M，便于用 SHOW VARIABLES 观察差异
innodb_buffer_pool_size = 256M

# 慢查询：超过 1 秒记入慢日志，配合 mysqldumpslow 分析
slow_query_log = 1
long_query_time = 1
slow_query_log_file = /var/lib/mysql/slow.log

# 字符集：统一 utf8mb4，避免 emoji 写入报错
character-set-server = utf8mb4
collation-server = utf8mb4_unicode_ci

# 连接数：默认 151，容器单机实验下调到 100，便于观察 Too many connections
max_connections = 100
